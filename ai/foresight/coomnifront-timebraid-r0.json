    },
    {
      "id": "board",
      "meaning": "Benefits, duties, budgets and alternatives",
      "preferred_view": "objectives, risk, scenarios, dissent, consent"
    },
    {
      "id": "research",
      "meaning": "What would falsify the claim",
      "preferred_view": "priors, alternatives, forecasts, counterexamples, independent replication"
    },
    {
      "id": "engineering",
      "meaning": "Exactly what can execute and recover",
      "preferred_view": "schema, transport, retry, idempotency, trace, rollback"
    },
    {
      "id": "agent",
      "meaning": "Allowed task and next safe deed",
      "preferred_view": "typed packet, source, cursor, lease, authority scope, exact receipt"
    },
    {
      "id": "mobile",
      "meaning": "One relevant change",
      "preferred_view": "glance and accessible detail, battery and notification limits"
    }
