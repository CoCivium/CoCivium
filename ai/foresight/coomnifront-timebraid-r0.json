  "temporal_forces": [
    {
      "id": "prior_push",
      "label": "Prior push",
      "epistemic": "OBSERVED_OR_HISTORICAL_WHEN_SOURCE_BOUND",
      "description": "Evidence, decisions, dissent, failures and obligations constrain current options",
      "can_authorize_effect": false
    },
    {
      "id": "here_now",
      "label": "Present decision",
      "epistemic": "CURRENT_ONLY_WHEN_VERIFIED_FOR_PURPOSE",
      "description": "Compare actual resources, authority, consent, observation and safe next action",
      "can_authorize_effect": false
    },
    {
      "id": "attractor_pull",
      "label": "Future pull",
      "epistemic": "SCENARIO_OR_PREFERRED_NOT_OBSERVED",
      "description": "Backcast from preferred outcomes and preregister forecasts and disconfirmers",
      "can_authorize_effect": false
    },
    {
      "id": "crosswind",
      "label": "Crosswind",
      "epistemic": "EXTERNAL_EVIDENCE_OR_UNKNOWN",
      "description": "Competitors, standards, climate, regulation, societal shifts and shocks",
      "can_authorize_effect": false
    },
    {
      "id": "feedback",
      "label": "CoBraid and CoAckRewise feedback",
      "epistemic": "RECEIPTED_OUTCOME",
      "description": "Compare preregistered forecast with observed outcome, preserve failures and supersessions",
      "can_authorize_effect": false
    }
  ],
