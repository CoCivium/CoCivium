  "null_states": [
    "OBSERVED_ZERO",
    "MISSING",
    "UNKNOWN",
    "NOT_APPLICABLE",
    "BELOW_DETECTION_LIMIT",
    "REDACTED",
    "INVALID",
    "UNDEFINED",
    "INFINITE_SYMBOLIC"
  ],
  "null_contract": "MISSING/UNKNOWN/REDACTED/NOT_APPLICABLE are not numeric zero; INFINITE_SYMBOLIC is mathematical, not a finite measurement.",
  "metric_families": [
    {
      "id": "CoTime.source_age",
      "definition": "observer UTC minus source UTC",
      "quantity_kind": "duration",
      "unit_id": "s",
      "scope": "defined clock and bounded skew"
    },
    {
      "id": "CoSpeedo.verified_useful_delta_rate",
      "definition": "receiver-accepted useful deltas divided by observed elapsed interval",
      "quantity_kind": "event_rate",
      "unit_id": "1/s",
      "scope": "requires exact numerator and verified receiver"
    },
    {
      "id": "CoMx.receiver_pickup_fraction",
      "definition": "accepted exact-object ACKs divided by attempted qualified deliveries",
      "quantity_kind": "fraction_of_whole",
      "unit_id": "ratio",
      "scope": "denominator zero means NOT_APPLICABLE"
    },
    {
      "id": "CoUX.human_touch_count",
      "definition": "count of discrete human interventions under declared policy",
      "quantity_kind": "event_count",
      "unit_id": "count",
      "scope": "cannot equate touches to cognitive load"
    },
    {
      "id": "CoResilience.mean_time_to_restore",
      "definition": "sum of recovered incident durations divided by recovered incident count",
      "quantity_kind": "duration",
      "unit_id": "s",
      "scope": "censored unresolved incidents separately"
    },
    {
      "id": "CoEnergy.useful_delta_per_joule",
      "definition": "receiver-accepted useful deltas divided by measured joules",
      "quantity_kind": "event_per_energy",
      "unit_id": "1/J",
      "scope": "energy boundary and cost separate"
    },
    {
      "id": "CoReach.failure_domain_coverage",
      "definition": "qualified independent recovery domains count",
      "quantity_kind": "failure_domain_count",
      "unit_id": "domain_count",
      "scope": "device count is not failure-domain count"
    }
  ],
