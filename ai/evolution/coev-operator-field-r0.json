  "root_name": "CoEv+ (proposed federation lens, not semantic owner or new actuating engine)",
  "regimes": [
    {
      "id": "EVO",
      "kind": "descriptive",
      "definition": "Change across generations under selection pressures; improvement unproven."
    },
    {
      "id": "AUTOEVO",
      "kind": "descriptive",
      "definition": "Unguided, emergent, decentralized or weakly guided selection regime; distinct from hosted automation."
    },
    {
      "id": "COEVO",
      "kind": "intentional",
      "definition": "Guided or hybrid, human/synth-stewarded evolutionary regime bounded by evidence and rights."
    },
    {
      "id": "META_EVO",
      "kind": "recursive",
      "definition": "Version and challenge mutation operators, definitions, and selection rules themselves."
    }
  ],
  "forces": [
    {
      "id": "PUSH_INTERNAL",
      "direction": "from_artifact",
      "epistemic": "DESIGN_HYPOTHESIS",
      "description": "Asset-level self-improvement requests; prior CoMetaTrainables, CoCTA, CoJustify names retained as unverified lineage pointers pending exact source."
    },
    {
      "id": "PULL_FUTURE",
      "direction": "from_candidate_future",
      "epistemic": "COUNTERFACTUAL",
      "description": "Forecasted future receiver need or a revised target state, never retrocausal physical force."
    },
    {
      "id": "DEMAND",
      "direction": "from_receiver",
      "epistemic": "OBSERVATIONAL_OR_PREFERRED",
      "description": "Explicit receiver requests, impact and independent feedback."
    },
    {
      "id": "SUPPLY",
      "direction": "from_available_capability",
      "epistemic": "OBSERVATIONAL_OR_HYPOTHESIS",
      "description": "Known available tools, substrates, resources and candidate capabilities."
    },
    {
      "id": "G_D_SIDE",
      "direction": "normative_candidate",
      "epistemic": "METAPHORICAL_OR_COUNTERFACTUAL",
      "description": "Plural benevolence/optionalities and future-wellbeing candidate lens; not divine instruction, observation or authority."
    },
    {
      "id": "SIDE_CONTEXT",
      "direction": "transverse",
      "epistemic": "HYPOTHESIS",
      "description": "Side effects, boundaries, cultural context, accessibility and nonparticipant interests."
    },
    {
      "id": "INVERSION",
      "direction": "reversal",
      "epistemic": "COUNTERFACTUAL",
      "description": "Removal, rollback, complement, negation or reversed route; may outperform addition."
    },
    {
      "id": "INTERSTICE",
      "direction": "between",
      "epistemic": "HYPOTHESIS",
      "description": "Missing interface, latency, transformation, translation loss, dependency or handoff."
    },
    {
      "id": "CONSERVATION",
      "direction": "preservation",
      "epistemic": "CONSTRAINT",
      "description": "Stable invariants, lineage custody, safety, restoration and long-lived counterexamples."
    },
    {
      "id": "STOCHASTIC",
      "direction": "exploration",
      "epistemic": "HYPOTHESIS",
      "description": "Bounded variation, mutation and recombination; source randomness not independent truth."
    }
  ],
  "operator_families": [
    {
      "id": "DISCOVER",
      "signature": "Evidence + Context -> CandidateClaims",
      "guards": [
        "PROVENANCE",
        "UNKNOWN_PRESERVED"
      ]
    },
    {
      "id": "MEASURE",
      "signature": "TypedClaim + Method + Instrument -> Observation|CoNull",
      "guards": [
        "MEASURE_TYPES",
        "TIME",
        "NO_MISSING_ZERO"
      ]
    },
    {
      "id": "CHALLENGE",
      "signature": "CandidateClaims + Alternatives -> Falsifiers",
      "guards": [
        "INVERSION",
        "NEGATIVE_CONTROLS"
      ]
    },
    {
      "id": "MUTATE",
      "signature": "AssetVersion + CandidateOperation -> Proposal",
      "guards": [
        "FORKABLE",
        "REVERSIBLE",
        "CHANGE_NOT_BETTER"
      ]
    },
    {
      "id": "RECOMBINE",
      "signature": "QualifiedSources + TypedMapping -> ProposedComposite",
      "guards": [
        "RIGHTS",
        "NO_SEMANTIC_LOSS_SILENCE"
      ]
    },
    {
      "id": "SELECT",
      "signature": "Alternatives + ContextualFitness -> ParetoFrontier",
      "guards": [
        "HARD_VETO_FIRST",
        "NO_UNIVERSAL_WINNER"
      ]
    },
    {
      "id": "COMMIT",
      "signature": "AuthorizedProposal + Lease + Receipt -> BoundedEffect|HOLD",
      "guards": [
        "ONE_ELECTED_ACTUATOR",
        "NO_SELF_AUTHORITY"
      ]
    },
    {
      "id": "RECOVER",
      "signature": "ExactCheckpoint + EligibleReceiver -> ReconstructedState|HOLD",
      "guards": [
        "INDEPENDENT_READPROOF",
        "FENCE_OLD_WRITER"
      ]
    },
    {
      "id": "EVOLVE_SELECTION",
      "signature": "SelectionRule + Counterexamples -> RevisedCandidateRule",
      "guards": [
        "PRECOMMITTED_BASELINE",
        "NO_REWRITING_HISTORY"
      ]
    },
    {
      "id": "EXPLORE_MYTH",
      "signature": "SymbolicMeaning + Context -> CandidateQuestions",
      "guards": [
        "METAPHOR_NE_MECHANISM",
        "NO_SPIRITUAL_AUTHORITY"
      ]
    }
  ],
