{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/coopen-relation-match-v0.1.schema.json",
  "title": "CoOpenRelation match candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "encounter_id",
    "receiver_id",
    "route_state",
    "gates",
    "held_reasons",
    "assignment_executed",
    "notification_executed",
    "authority_change",
    "nonclaims"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "minLength": 1
    },
    "encounter_id": {
      "type": "string",
      "minLength": 1
    },
    "receiver_id": {
      "type": "string",
      "minLength": 1
    },
    "route_state": {
      "enum": [
        "MATCH_CANDIDATE",
        "HELD"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_open",
        "capability_match",
        "interest_match",
        "consent_ok",
        "authority_ok",
        "cost_ok",
        "currentness_ok"
      ],
      "properties": {
        "status_open": {
          "type": "boolean"
        },
        "capability_match": {
          "type": "boolean"
        },
        "interest_match": {
          "type": "boolean"
        },
        "consent_ok": {
          "type": "boolean"
        },
        "authority_ok": {
          "type": "boolean"
        },
        "cost_ok": {
          "type": "boolean"
        },
        "currentness_ok": {
          "type": "boolean"
        }
      }
    },
    "held_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_deed": {
      "type": [
        "object",
        "null"
      ]
    },
    "assignment_executed": {
      "const": false
    },
    "notification_executed": {
      "const": false
    },
    "authority_change": {
      "const": false
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
