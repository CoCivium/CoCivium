{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/cosession-subscription-profile-v0.1.schema.json",
  "title": "CoSession subscription profile v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "hot",
    "warm",
    "digest",
    "preferred_repos"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "hot": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "warm": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "digest": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preferred_repos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
