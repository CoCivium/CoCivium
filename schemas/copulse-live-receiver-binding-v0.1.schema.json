{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/copulse-live-receiver-binding-v0.1.schema.json",
  "title": "CoPulse live receiver binding v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","state","binding_id","receiver_id","virtual_session_id","participant_id",
    "participant_class","embodiment_id","embodiment_class","observed_at",
    "liveness_challenge","authority_ceiling","confidentiality","lifecycle_scope","nonclaims"
  ],
  "properties": {
    "schema": {"const":"CoPulseLiveReceiverBinding.R0G.v0.1-candidate"},
    "state": {"const":"PROVEN_LIVE_FOR_BOUNDED_LOCAL_CANARY"},
    "binding_id": {"type":"string","minLength":1},
    "receiver_id": {"type":"string","minLength":1},
    "virtual_session_id": {"type":"string","minLength":1},
    "participant_id": {"type":"string","minLength":1},
    "participant_class": {"const":"RECEIVER"},
    "embodiment_id": {"type":"string","minLength":1},
    "embodiment_class": {"enum":["LOCAL_PROCESS","GITHUB_JOB","MCP_ADAPTER","PROVIDER_SESSION","OTHER"]},
    "observed_at": {"type":"string","format":"date-time"},
    "liveness_challenge": {
      "type":"object",
      "additionalProperties":false,
      "required":["method","challenge_sha256","response_sha256"],
      "properties":{
        "method":{"const":"STDIN_CHALLENGE_RESPONSE"},
        "challenge_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"},
        "response_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"}
      }
    },
    "authority_ceiling":{"type":"string","minLength":1},
    "confidentiality":{"enum":["PUBLIC","PRIVATE","RESTRICTED","UNKNOWN"]},
    "lifecycle_scope":{"const":"PROCESS_LIFETIME_ONLY"},
    "nonclaims":{"type":"array","items":{"type":"string"}}
  }
}