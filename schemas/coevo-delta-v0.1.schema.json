{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/coevo-delta-v0.1.schema.json",
  "title": "CoEvoDelta v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "session_id",
    "observed_at",
    "domain",
    "subject",
    "relation",
    "epistemic_class",
    "source_refs",
    "target_surfaces",
    "mutation_class",
    "authority_ceiling",
    "confidentiality",
    "next_receiver"
  ],
  "properties": {
    "delta_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_class": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "HYPOTHESIS",
        "PREDICTED",
        "PLANNED",
        "PREFERRED",
        "METAPHORICAL",
        "MYTHIC",
        "HUMOROUS",
        "COUNTERFACTUAL",
        "UNKNOWN"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mutation_class": {
      "enum": [
        "OBSERVE",
        "PROPOSE",
        "BRANCH_MUTATE",
        "REVIEW_CHALLENGE",
        "MERGE_LOW_EFFECT",
        "EFFECT_GATED"
      ]
    },
    "authority_ceiling": {
      "type": "string"
    },
    "confidentiality": {
      "enum": [
        "PUBLIC",
        "PRIVATE",
        "RESTRICTED",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_benefit": {
      "type": [
        "string",
        "null"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wake_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_receiver": {
      "type": "string",
      "minLength": 1
    }
  }
}
