{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/cosession-relational-delta-v0.1.schema.json",
  "title": "CoSession relational delta v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "source_session",
    "created_at",
    "target_domains",
    "operations",
    "authority_ceiling",
    "public_safety",
    "nonclaims",
    "next_gate"
  ],
  "properties": {
    "delta_id": {"type": "string", "minLength": 1},
    "source_session": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_domains": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "subject", "relation"],
        "properties": {
          "op": {
            "enum": ["ADD", "QUALIFY", "CHALLENGE", "LINK", "INDEX", "HIGHLIGHT", "DEPRECATE", "RESTRUCTURE", "PROJECT"]
          },
          "subject": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "object": {"type": ["string", "null"]},
          "qualifiers": {"type": "object"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "candidate_surfaces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authority_ceiling": {"type": "string", "minLength": 1},
    "public_safety": {
      "enum": ["PUBLIC_SAFE", "PUBLIC_SAFE_WITH_REDACTION", "PRIVATE_ONLY", "UNKNOWN"]
    },
    "collision_domain": {"type": ["string", "null"]},
    "supersedes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "next_gate": {"type": "string", "minLength": 1}
  }
}
