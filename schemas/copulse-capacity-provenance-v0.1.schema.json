{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/copulse-capacity-provenance-v0.1.schema.json",
  "title": "CoPulse capacity-source provenance v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_id","sample_id","receiver_id","capacity_source",
    "pressure_input_sha256","source_identity","source_method",
    "source_object_ref","source_object_sha256","evidence_refs",
    "authority_ceiling","confidentiality"
  ],
  "properties": {
    "provenance_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "receiver_id": {"type": "string", "minLength": 1},
    "capacity_source": {"enum": ["MEASURED","DECLARED","SYNTHETIC_FIXTURE"]},
    "pressure_input_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_identity": {"type": "string", "minLength": 1},
    "source_method": {"type": "string", "minLength": 1},
    "source_object_ref": {"type": "string", "minLength": 1},
    "source_object_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "confidentiality": {"enum": ["PUBLIC","PRIVATE","RESTRICTED","UNKNOWN"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
