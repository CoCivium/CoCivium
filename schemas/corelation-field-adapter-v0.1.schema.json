{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/corelation-field-adapter-v0.1.schema.json",
  "title":"CoRelationField adapter pack v0.1 candidate",
  "description":"Pointer-only adapter contract from existing CoCivium domain carriers into/out of CoRelationField without semantic ownership, authority, lifecycle or mutation transfer.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","adapter_pack_id","observed_base_ref","field_schema_path","field_schema_blob_sha","bindings","nonclaims"],
  "properties":{
    "schema_version":{"const":"CoRelationField.AdapterPack.v0.1-candidate"},
    "adapter_pack_id":{"type":"string","minLength":1},
    "observed_base_ref":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "field_schema_path":{"const":"schemas/corelation-field-v0.1.schema.json"},
    "field_schema_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "bindings":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":[
          "binding_id","source_carrier","source_path","source_blob_sha","source_instance_ref",
          "relation_field_id","relation_ids","binding_role","direction",
          "source_semantics_owner","relation_typing_owner","pointer_semantics",
          "authority_change","source_mutated","field_mutated","lifecycle_claims",
          "loss_declarations","nonclaims"
        ],
        "properties":{
          "binding_id":{"type":"string","minLength":1},
          "source_carrier":{"type":"string","pattern":"^[A-Z][A-Z0-9_+.-]*$"},
          "source_path":{"type":"string","minLength":1},
          "source_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
          "source_instance_ref":{"type":"string","minLength":1},
          "relation_field_id":{"type":"string","minLength":1},
          "relation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "binding_role":{"type":"string","pattern":"^[A-Z][A-Z0-9_+.-]*$"},
          "direction":{"enum":["SOURCE_TO_FIELD_POINTER","FIELD_TO_SOURCE_POINTER","BIDIRECTIONAL_REFERENCE"]},
          "source_semantics_owner":{"const":"SOURCE_CARRIER"},
          "relation_typing_owner":{"const":"CORELATION_FIELD"},
          "pointer_semantics":{"const":"REFERENCE_ONLY"},
          "authority_change":{"const":false},
          "source_mutated":{"const":false},
          "field_mutated":{"const":false},
          "lifecycle_claims":{
            "type":"object","additionalProperties":false,
            "required":["picked_up","integrated","canon","runtime","coex"],
            "properties":{
              "picked_up":{"const":false},
              "integrated":{"const":false},
              "canon":{"const":false},
              "runtime":{"const":false},
              "coex":{"const":false}
            }
          },
          "loss_declarations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}