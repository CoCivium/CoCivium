{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/cotime-decision-evidence-v0.1.schema.json",
  "title":"CoTime decision evidence v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","object_id","epistemic_class","currentness","source_refs","observed_at","decision_class","route_state","authority_ceiling","nonclaims"],
  "properties":{
    "schema":{"const":"CoTimeDecisionEvidence.v0.1-candidate"},
    "object_id":{"type":"string","minLength":1},
    "epistemic_class":{"enum":["OBSERVED","INFERRED","PREDICTED","SCENARIO","COUNTERFACTUAL","UNKNOWN"]},
    "currentness":{"enum":["CURRENT","STALE","SUPERSEDED","UNKNOWN"]},
    "source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "source_time":{"type":["string","null"]},
    "observed_at":{"type":"string","format":"date-time"},
    "recorded_at":{"type":["string","null"]},
    "valid_from":{"type":["string","null"]},
    "valid_to":{"type":["string","null"]},
    "decision_time":{"type":["string","null"]},
    "horizon_end":{"type":["string","null"]},
    "calibration_due":{"type":["string","null"]},
    "confidence":{"type":["number","null"],"minimum":0,"maximum":1},
    "supersedes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "decision_class":{"enum":["RESEARCH_ONLY","PRIVATE_DISCUSSION","PROFESSIONAL_REVIEW_TRIGGER","DECISION_CANDIDATE","EFFECT_GATED"]},
    "role_profile":{"type":"string"},
    "jurisdiction_profile":{"type":"string"},
    "professional_review_required":{"type":"boolean"},
    "route_state":{"enum":["ALLOW_RESEARCH","ALLOW_PRIVATE_DISCUSSION","HOLD_CURRENTNESS","HOLD_ROLE_OR_JURISDICTION","HOLD_PROFESSIONAL_REVIEW","HOLD_EFFECT_GATE"]},
    "authority_ceiling":{"const":"ADVISORY_ONLY"},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "counterarguments":{"type":"array","items":{"type":"string"}},
    "calibration_disposition":{"enum":["NOT_DUE","HIT","PARTIAL","MISS","UNRESOLVED","CENSORED","INVALIDATED_BY_ASSUMPTION_CHANGE"]},
    "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}