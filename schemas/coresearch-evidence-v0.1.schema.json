{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/coresearch-evidence-v0.1.schema.json",
  "title": "CoAll Research Evidence Record v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "observed_at",
    "epistemic_class",
    "claim",
    "source_refs",
    "tests",
    "confidence",
    "authority_ceiling",
    "confidentiality",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "CoAll.ResearchEvidence.v0.1-candidate"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_time": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "epistemic_class": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "HYPOTHESIS",
        "PREDICTED",
        "PLANNED",
        "PREFERRED",
        "METAPHORICAL",
        "MYTHIC",
        "HUMOROUS",
        "COUNTERFACTUAL",
        "UNKNOWN"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "state"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "PASS",
              "FAIL",
              "HOLD",
              "NOT_RUN"
            ]
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "authority_ceiling": {
      "enum": [
        "NONE",
        "CANDIDATE_BRANCH_ONLY",
        "ADVISORY",
        "HUMAN_GATE",
        "EFFECT_GATED"
      ]
    },
    "confidentiality": {
      "enum": [
        "PUBLIC",
        "PRIVATE",
        "RESTRICTED",
        "UNKNOWN"
      ]
    },
    "legal_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "review_status": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_REVIEWED",
            "REVIEWED",
            "HOLD"
          ]
        }
      }
    },
    "forecast_horizon": {
      "type": "string"
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterarguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_gate": {
      "type": "string"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "research_recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources_read": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "version",
              "observed_at"
            ]
          }
        },
        "finding": {
          "enum": [
            "PRESENT",
            "UNRESOLVED",
            "SCOPED_ABSENCE"
          ]
        },
        "basis": {
          "enum": [
            "SOURCE_READ",
            "SEARCH_ONLY",
            "OBSERVER_UNAVAILABLE",
            "AUTHORITATIVE_BOUNDED_INVENTORY"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "coverage": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ref",
            "version",
            "observed_at",
            "coverage"
          ]
        },
        "resource_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "cost_or_unknown": {
                "type": "string",
                "minLength": 1
              },
              "inspection": {
                "enum": [
                  "INSPECTED",
                  "LISTED",
                  "UNAVAILABLE"
                ]
              },
              "disposition": {
                "enum": [
                  "SELECTED",
                  "DEFERRED",
                  "UNAVAILABLE"
                ]
              }
            },
            "required": [
              "id",
              "reason",
              "cost_or_unknown",
              "inspection",
              "disposition"
            ]
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "RECORDED",
                "WRITEBACK_UNAVAILABLE"
              ]
            },
            "next_deed": {
              "type": "string",
              "minLength": 1
            },
            "wake_condition": {
              "type": "string",
              "minLength": 1
            },
            "result_ref": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "next_deed",
            "wake_condition"
          ]
        }
      },
      "required": [
        "sources_read",
        "finding",
        "basis",
        "scope",
        "resource_options",
        "continuation"
      ]
    },
    "extraordinary_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "CANDIDATE",
            "PROMOTION_REQUESTED"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "missing_verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "primary_observations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "independent_corroboration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "prior_art_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "adversarial_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "prospective_falsifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        },
        "domain_verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "HOLD",
                "NOT_RUN"
              ]
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "source_refs",
            "observed_at"
          ]
        }
      },
      "required": [
        "disposition",
        "domain"
      ]
    }
  }
}
