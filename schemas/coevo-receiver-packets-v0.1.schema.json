{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/coevo-receiver-packets-v0.1.schema.json",
  "title":"CoEvo receiver packet bundle v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["compiler","coverage","repository_packets","session_packets","holds","effects","next","nonclaims","bundle_sha256","inputs"],
  "properties":{
    "compiler":{"const":"CoEvoReceiverPacketCompiler.R0"},
    "coverage":{"type":"object"},
    "repository_packets":{"type":"array","items":{"$ref":"#/$defs/repoPacket"}},
    "session_packets":{"type":"array","items":{"$ref":"#/$defs/sessionPacket"}},
    "holds":{"type":"array","items":{"type":"object"}},
    "effects":{"$ref":"#/$defs/zeroEffects"},
    "next":{"type":"string"},
    "nonclaims":{"type":"array","items":{"type":"string"}},
    "bundle_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"},
    "inputs":{
      "type":"object",
      "additionalProperties":false,
      "required":["plan","coevo","bindings"],
      "properties":{
        "plan":{"$ref":"#/$defs/inputMeta"},
        "coevo":{"$ref":"#/$defs/inputMeta"},
        "bindings":{"$ref":"#/$defs/inputMeta"}
      }
    }
  },
  "$defs":{
    "inputMeta":{
      "type":"object","additionalProperties":false,"required":["sha256","bytes"],
      "properties":{"sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"},"bytes":{"type":"integer","minimum":0}}
    },
    "repoPacket":{
      "type":"object",
      "required":["packet_class","delta_id","receiver_id","receiver_repo","expected_target_head","route_id","coevo_delta","delivery_state","effects","nonclaims","packet_id","packet_sha256"],
      "properties":{
        "packet_class":{"const":"REPOSITORY_CANDIDATE"},
        "delta_id":{"type":"string"},
        "receiver_id":{"type":"string"},
        "receiver_repo":{"type":"string"},
        "expected_target_head":{"type":"string"},
        "route_id":{"type":"string"},
        "route_state":{},"proposed_action":{},
        "downstream_gates":{"type":"array","items":{"type":"string"}},
        "receiver_readproof_gate":{},"next_gate":{},
        "coevo_delta":{"type":"object"},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "delivery_state":{"const":"PACKET_COMPILED__NOT_DELIVERED"},
        "effects":{
          "type":"object","additionalProperties":false,
          "required":["target_mutation","branch_creation","pull_request_creation","publication","receiver_pickup_claim"],
          "properties":{"target_mutation":{"const":0},"branch_creation":{"const":0},"pull_request_creation":{"const":0},"publication":{"const":0},"receiver_pickup_claim":{"const":0}}
        },
        "nonclaims":{"type":"array","items":{"type":"string"}},
        "packet_id":{"type":"string","pattern":"^packet:[0-9A-F]{24}$"},
        "packet_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"}
      }
    },
    "sessionPacket":{
      "type":"object",
      "required":["packet_class","delta_id","receiver_instance_id","profile_id","currentness_cursor","subscription_id","temperature","delivery_class","coevo_delta","delivery_state","effects","nonclaims","packet_id","packet_sha256"],
      "properties":{
        "packet_class":{"const":"SESSION_CURRENTNESS_CANDIDATE"},
        "delta_id":{"type":"string"},
        "receiver_instance_id":{"type":"string"},
        "profile_id":{"type":"string"},
        "currentness_cursor":{"type":"string"},
        "subscription_id":{"type":"string"},
        "temperature":{"enum":["HOT","WARM","DIGEST"]},
        "delivery_class":{"type":"string"},
        "matched_domains":{"type":"array","items":{"type":"string"}},
        "coevo_delta":{"type":"object"},
        "delivery_state":{"const":"PACKET_COMPILED__NOT_DELIVERED"},
        "effects":{
          "type":"object","additionalProperties":false,
          "required":["provider_session_push","session_mutation","authority_transfer","receiver_pickup_claim"],
          "properties":{"provider_session_push":{"const":0},"session_mutation":{"const":0},"authority_transfer":{"const":0},"receiver_pickup_claim":{"const":0}}
        },
        "nonclaims":{"type":"array","items":{"type":"string"}},
        "packet_id":{"type":"string","pattern":"^packet:[0-9A-F]{24}$"},
        "packet_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"}
      }
    },
    "zeroEffects":{
      "type":"object","additionalProperties":false,
      "required":["deliveries_executed","target_mutations","branches_created","pull_requests_created","provider_session_pushes","receiver_pickup_claims","canon_changes"],
      "properties":{
        "deliveries_executed":{"const":0},"target_mutations":{"const":0},"branches_created":{"const":0},
        "pull_requests_created":{"const":0},"provider_session_pushes":{"const":0},
        "receiver_pickup_claims":{"const":0},"canon_changes":{"const":0}
      }
    }
  }
}
