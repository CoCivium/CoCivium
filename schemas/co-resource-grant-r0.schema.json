{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cocivium.example/schemas/co-resource-grant-r0.schema.json",
  "title": "CoResourceGrant R0",
  "description": "Candidate participant-owned resource grant interface. Grant semantics do not schedule or execute work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "participant_or_owner",
    "resource_class",
    "purpose_scope",
    "privacy_scope",
    "state",
    "capacity",
    "revocation",
    "provenance",
    "current"
  ],
  "properties": {
    "schema": {
      "const": "CoResourceGrant.R0"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "participant_or_owner": {
      "type": "string",
      "minLength": 1
    },
    "resource_class": {
      "type": "string",
      "minLength": 1
    },
    "purpose_scope": {
      "type": "string",
      "minLength": 1
    },
    "privacy_scope": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "OFFERED",
        "REVIEWED",
        "ACTIVE",
        "PAUSED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "capacity": {
      "type": "number",
      "minimum": 0
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revocable",
        "revoked"
      ],
      "properties": {
        "revocable": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "current": {
      "type": "boolean"
    }
  }
}
