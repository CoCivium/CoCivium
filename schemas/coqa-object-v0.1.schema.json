{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/coqa-object-v0.1.schema.json",
  "title":"CoQ&A object v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","qa_id","question","answers","currentness","benefit_posture","authority_ceiling","confidentiality","nonclaims"],
  "properties":{
    "schema":{"const":"CoQAObject.v0.1-candidate"},
    "qa_id":{"type":"string","minLength":1},
    "question":{
      "type":"object","additionalProperties":false,
      "required":["question_id","text","classes","observed_at"],
      "properties":{
        "question_id":{"type":"string","minLength":1},
        "text":{"type":"string","minLength":1},
        "classes":{"type":"array","minItems":1,"items":{"enum":["FACTUAL","EXPLANATORY","PROCEDURAL","COMPARATIVE","DIAGNOSTIC","CREATIVE","REFLECTIVE","TRAINING","MYSTERY","OPEN_RESEARCH","COUNTERFACTUAL","PREDICTIVE","HUMOROUS"]},"uniqueItems":true},
        "observed_at":{"type":"string","format":"date-time"},
        "source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "assumptions":{"type":"array","items":{"type":"string"}},
        "open_subquestions":{"type":"array","items":{"type":"string"}},
        "receiver_scope":{"type":"string"}
      }
    },
    "answers":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["answer_id","epistemic_class","answer_core","observed_at","confidence","source_refs","projection_kind","nonclaims"],
        "properties":{
          "answer_id":{"type":"string","minLength":1},
          "epistemic_class":{"enum":["OBSERVED","INFERRED","HYPOTHESIS","PREDICTED","PLANNED","PREFERRED","METAPHORICAL","MYTHIC","HUMOROUS","COUNTERFACTUAL","UNKNOWN"]},
          "answer_core":{"type":"string","minLength":1},
          "observed_at":{"type":"string","format":"date-time"},
          "valid_from":{"type":["string","null"]},
          "valid_to":{"type":["string","null"]},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
          "projection_kind":{"enum":["CORE","PLAIN","TECHNICAL","HUMOR","MYSTERY","TRAINING","HISTORICAL","VISUAL","MACHINE_TWIN"]},
          "supersedes":{"type":["string","null"]},
          "challenge_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
          "next_questions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
          "uncertainty":{"type":"array","items":{"type":"string"}},
          "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
        }
      }
    },
    "currentness":{
      "type":"object","additionalProperties":false,
      "required":["state","as_of"],
      "properties":{
        "state":{"enum":["CURRENT","TIME_SENSITIVE","STALE","SUPERSEDED","OPEN","UNKNOWN"]},
        "as_of":{"type":"string","format":"date-time"},
        "successor_answer_id":{"type":["string","null"]}
      }
    },
    "benefit_posture":{
      "type":"object","additionalProperties":false,
      "required":["objective","engagement_maximization"],
      "properties":{
        "objective":{"enum":["USEFUL_RELATION_RECURRENCE","ORIENTATION","UNDERSTANDING","DECISION_SUPPORT","SKILL_TRANSFER","CURIOSITY","OPEN_RESEARCH","HUMOUR","NONE"]},
        "engagement_maximization":{"const":false},
        "intended_benefit":{"type":"string"},
        "observed_benefit_ref":{"type":["string","null"]}
      }
    },
    "core_candidate":{
      "type":["object","null"],
      "additionalProperties":false,
      "properties":{
        "subject":{"type":"string"},
        "relation":{"type":"string"},
        "object":{"type":"string"},
        "projection_loss":{"type":"array","items":{"type":"string"}}
      }
    },
    "authority_ceiling":{"enum":["OBSERVE_ONLY","CANDIDATE_ONLY","LOCAL_REVERSIBLE","EFFECT_GATED"]},
    "confidentiality":{"enum":["PUBLIC","PRIVATE","RESTRICTED","UNKNOWN"]},
    "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}