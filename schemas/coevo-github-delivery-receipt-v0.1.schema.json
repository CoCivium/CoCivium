{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/coevo-github-delivery-receipt-v0.1.schema.json",
  "title":"CoEvo GitHub delivery receipt v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "receipt_id","adapter_id","packet_id","packet_sha256",
    "destination_repo","destination_branch","precondition_head",
    "destination_path","landing_commit","git_blob_sha",
    "state","lifecycle_state","destination_readback",
    "receiver_pickup_state","recovery","nonclaims"
  ],
  "properties":{
    "receipt_id":{"type":"string","minLength":1},
    "adapter_id":{"const":"CoGitHubReceiverAdapter.R0"},
    "packet_id":{"type":"string","pattern":"^packet:[0-9A-F]{24}$"},
    "packet_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"},
    "packet_file_sha256":{"type":"string","pattern":"^[0-9A-F]{64}$"},
    "destination_repo":{"type":"string","minLength":1},
    "destination_branch":{"type":"string","minLength":1},
    "precondition_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "destination_path":{"type":"string","minLength":1},
    "landing_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "git_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "state":{"const":"LANDED__DESTINATION_READBACK_PASS__PICKUP_UNPROVEN"},
    "lifecycle_state":{"const":"LANDED"},
    "destination_readback":{
      "type":"object",
      "additionalProperties":false,
      "required":["method","commit_ref","path","exact_content_match","coverage"],
      "properties":{
        "method":{"const":"GITHUB_EXACT_FILE_READBACK"},
        "commit_ref":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "path":{"type":"string"},
        "exact_content_match":{"const":true},
        "coverage":{"const":"EXACT_PACKET_OBJECT_ONLY"}
      }
    },
    "receiver_pickup_state":{"const":"UNPROVEN"},
    "recovery":{
      "type":"object",
      "additionalProperties":false,
      "required":["source_branch","landing_commit","rollback_policy"],
      "properties":{
        "source_branch":{"type":"string"},
        "landing_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "rollback_policy":{"const":"REVERT_CANDIDATE_BRANCH_COMMIT_OR_DELETE_INBOX_OBJECT_WITH_EXPLICIT_REVIEW"}
      }
    },
    "nonclaims":{"type":"array","items":{"type":"string"}}
  }
}
