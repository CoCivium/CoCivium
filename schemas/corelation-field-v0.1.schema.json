{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/corelation-field-v0.1.schema.json",
  "title": "CoRelationField v0.1 candidate",
  "description": "Typed recursive relation-field candidate spanning causal, non-causal, negative-space, modal, projection and meta-relational structures. Candidate only; no ontology-completeness, runtime, canon or authority claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_id",
    "state",
    "max_relation_depth",
    "relata",
    "relations",
    "transforms",
    "projections",
    "nonclaims"
  ],
  "properties": {
    "schema_version": { "const": "CoRelationField.v0.1-candidate" },
    "field_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["SYNTHETIC_FIXTURE", "CANDIDATE"] },
    "max_relation_depth": { "type": "integer", "minimum": 0, "maximum": 16 },
    "relata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "OBJECT",
              "EVENT",
              "PROCESS",
              "PARTICIPANT",
              "RELATION",
              "ABSENCE",
              "NON_EVENT",
              "MISSING_EVIDENCE",
              "CONSTRAINT",
              "INVARIANT",
              "POSSIBILITY",
              "COUNTERFACTUAL",
              "QUESTION",
              "HYPOTHESIS",
              "MODEL",
              "PLAN",
              "BOUNDARY",
              "UNKNOWN",
              "PROJECTION",
              "TRANSFORMATION"
            ]
          },
          "label": { "type": ["string", "null"] },
          "scope_note": { "type": ["string", "null"] }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_id",
          "predicate",
          "relation_family",
          "causal_status",
          "relata",
          "epistemic_class",
          "evidence_refs",
          "confidence",
          "mechanism",
          "counterfactual_basis",
          "time_scope",
          "context_scope",
          "observer_or_receiver",
          "meta_depth",
          "provenance",
          "nonclaims"
        ],
        "properties": {
          "relation_id": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "relation_family": {
            "enum": [
              "CAUSAL",
              "STATISTICAL_INFORMATIONAL",
              "TEMPORAL",
              "LOGICAL_MATHEMATICAL_CONSTRAINT",
              "STRUCTURAL_TOPOLOGICAL_COMPOSITIONAL",
              "SEMANTIC_SYMBOLIC_METAPHORICAL",
              "EPISTEMIC_EVIDENCE",
              "PROVENANCE_LINEAGE",
              "NORMATIVE_AUTHORITY_CONSENT",
              "MODAL_COUNTERFACTUAL",
              "OBSERVER_PROJECTION",
              "EMERGENT_MULTISCALE",
              "QUANTUM_EVIDENCE_BOUNDED",
              "TRANSFORMATIONAL_GENERATIVE",
              "META_RELATIONAL"
            ]
          },
          "causal_status": {
            "enum": [
              "CAUSAL_SUPPORTED",
              "CAUSAL_CANDIDATE",
              "NONCAUSAL",
              "COMMON_CAUSE_CANDIDATE",
              "COUNTERFACTUAL_DEPENDENCE",
              "CONSTRAINT_RELATION",
              "UNKNOWN_CAUSAL_STATUS",
              "CAUSALITY_NOT_APPLICABLE"
            ]
          },
          "relata": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "kind"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "kind": {
                  "enum": [
                    "OBJECT",
                    "EVENT",
                    "PROCESS",
                    "PARTICIPANT",
                    "RELATION",
                    "ABSENCE",
                    "NON_EVENT",
                    "MISSING_EVIDENCE",
                    "CONSTRAINT",
                    "INVARIANT",
                    "POSSIBILITY",
                    "COUNTERFACTUAL",
                    "QUESTION",
                    "HYPOTHESIS",
                    "MODEL",
                    "PLAN",
                    "BOUNDARY",
                    "UNKNOWN",
                    "PROJECTION",
                    "TRANSFORMATION"
                  ]
                }
              }
            }
          },
          "epistemic_class": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "HYPOTHESIS",
              "PREDICTED",
              "PLANNED",
              "PREFERRED",
              "METAPHORICAL",
              "MYTHIC",
              "HUMOROUS",
              "COUNTERFACTUAL",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "mechanism": { "type": ["string", "null"] },
          "counterfactual_basis": { "type": ["string", "null"] },
          "time_scope": { "type": ["string", "null"] },
          "context_scope": { "type": ["string", "null"] },
          "observer_or_receiver": { "type": ["string", "null"] },
          "meta_depth": { "type": "integer", "minimum": 0 },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "nonclaims": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "causal_status": { "const": "CAUSAL_SUPPORTED" } },
              "required": ["causal_status"]
            },
            "then": {
              "properties": {
                "relation_family": { "const": "CAUSAL" },
                "mechanism": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "relation_family": { "const": "CAUSAL" } },
              "required": ["relation_family"]
            },
            "then": {
              "properties": {
                "causal_status": {
                  "enum": ["CAUSAL_SUPPORTED", "CAUSAL_CANDIDATE"]
                }
              }
            }
          }
        ]
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transform_id",
          "operation",
          "source_relation_ids",
          "output_relation_ids",
          "loss_declarations",
          "provenance_refs",
          "source_mutated"
        ],
        "properties": {
          "transform_id": { "type": "string", "minLength": 1 },
          "operation": {
            "enum": [
              "COMBINE",
              "SMOOSH",
              "SPLIT",
              "INVERT",
              "ROTATE_PERSPECTIVE",
              "TRANSLATE_DOMAIN",
              "RECURSE",
              "FEDERATE",
              "ADVERSARIAL_CHALLENGE",
              "CONSTRAIN",
              "RANDOMIZE",
              "COMPRESS",
              "EXPAND",
              "TEMPORAL_SHIFT",
              "COUNTERFACTUALIZE",
              "RECOMPOSE",
              "MARMALIZE"
            ]
          },
          "source_relation_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "output_relation_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "loss_declarations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "provenance_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "source_mutated": { "const": false }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projection_id",
          "projection_kind",
          "selected_relation_ids",
          "omitted_relation_ids",
          "loss_declarations",
          "source_mutated"
        ],
        "properties": {
          "projection_id": { "type": "string", "minLength": 1 },
          "projection_kind": {
            "enum": [
              "CAUSAL_CHAIN",
              "NONCAUSAL_GRAPH",
              "NARRATIVE",
              "FORMAL",
              "COCRYSTALMORPH_SURFACE"
            ]
          },
          "selected_relation_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "omitted_relation_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "loss_declarations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "source_mutated": { "const": false }
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
