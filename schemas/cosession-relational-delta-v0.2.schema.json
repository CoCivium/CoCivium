{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/cosession-relational-delta-v0.2.schema.json",
  "title": "CoSession relational delta projection v0.2 candidate",
  "description": "Compilable session/receiver projection of CoEvoDelta+; not a parallel semantic standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_of",
    "delta_id",
    "source_session",
    "created_at",
    "target_domains",
    "operations",
    "authority_ceiling",
    "confidentiality",
    "public_safety",
    "next_receiver",
    "nonclaims",
    "next_gate"
  ],
  "properties": {
    "projection_of": {"const": "CoEvoDelta+"},
    "delta_id": {"type": "string", "minLength": 1},
    "source_session": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "target_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "subject", "relation", "epistemic_class", "mutation_class"],
        "properties": {
          "op": {"enum": ["ADD", "QUALIFY", "CHALLENGE", "LINK", "INDEX", "HIGHLIGHT", "DEPRECATE", "RESTRUCTURE", "PROJECT"]},
          "subject": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "object": {"type": ["string", "null"]},
          "epistemic_class": {"enum": ["OBSERVED", "INFERRED", "HYPOTHESIS", "PREDICTED", "PLANNED", "PREFERRED", "METAPHORICAL", "MYTHIC", "HUMOROUS", "COUNTERFACTUAL", "UNKNOWN"]},
          "mutation_class": {"enum": ["OBSERVE", "PROPOSE", "BRANCH_MUTATE", "REVIEW_CHALLENGE", "MERGE_LOW_EFFECT", "EFFECT_GATED"]},
          "qualifiers": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "contradictions": {"type": "array", "items": {"type": "string"}},
          "tests": {"type": "array", "items": {"type": "string"}},
          "expected_benefit": {"type": ["string", "null"]},
          "risks": {"type": "array", "items": {"type": "string"}},
          "wake_conditions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "candidate_surfaces": {"type": "array", "items": {"type": "string"}},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "confidentiality": {"enum": ["PUBLIC", "PRIVATE", "RESTRICTED", "UNKNOWN"]},
    "public_safety": {"enum": ["PUBLIC_SAFE", "PUBLIC_SAFE_WITH_REDACTION", "PRIVATE_ONLY", "UNKNOWN"]},
    "collision_domain": {"type": ["string", "null"]},
    "observed_base_ref": {"type": ["string", "null"]},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "next_receiver": {"type": "string", "minLength": 1},
    "receiver_readproof_gate": {"type": ["string", "null"]},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1}
  }
}
