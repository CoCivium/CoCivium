{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoCivium/CoCivium/schemas/coevo-delta-v0.2.schema.json",
  "title": "CoEvoDelta v0.2 candidate",
  "description": "CoEvoDelta v0.1-compatible core plus typed operation, object, public-safety, currentness, receiver and projection provenance fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "session_id",
    "observed_at",
    "domain",
    "subject",
    "relation",
    "epistemic_class",
    "source_refs",
    "target_surfaces",
    "mutation_class",
    "authority_ceiling",
    "confidentiality",
    "next_receiver"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "delta_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "domain": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "subject": {"type": "string", "minLength": 1},
    "relation": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "null"]},
    "typed_operation": {"enum": ["ADD", "QUALIFY", "CHALLENGE", "LINK", "INDEX", "HIGHLIGHT", "DEPRECATE", "RESTRUCTURE", "PROJECT"]},
    "epistemic_class": {"enum": ["OBSERVED", "INFERRED", "HYPOTHESIS", "PREDICTED", "PLANNED", "PREFERRED", "METAPHORICAL", "MYTHIC", "HUMOROUS", "COUNTERFACTUAL", "UNKNOWN"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "target_surfaces": {"type": "array", "items": {"type": "string"}},
    "mutation_class": {"enum": ["OBSERVE", "PROPOSE", "BRANCH_MUTATE", "REVIEW_CHALLENGE", "MERGE_LOW_EFFECT", "EFFECT_GATED"]},
    "authority_ceiling": {"type": "string"},
    "confidentiality": {"enum": ["PUBLIC", "PRIVATE", "RESTRICTED", "UNKNOWN"]},
    "public_safety": {"enum": ["PUBLIC_SAFE", "PUBLIC_SAFE_WITH_REDACTION", "PRIVATE_ONLY", "UNKNOWN"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "qualifiers": {"type": "object"},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "expected_benefit": {"type": ["string", "null"]},
    "risks": {"type": "array", "items": {"type": "string"}},
    "wake_conditions": {"type": "array", "items": {"type": "string"}},
    "collision_domain": {"type": ["string", "null"]},
    "observed_base_ref": {"type": ["string", "null"]},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "next_receiver": {"type": "string", "minLength": 1},
    "next_gate": {"type": ["string", "null"]},
    "receiver_readproof_gate": {"type": ["string", "null"]},
    "nonclaims": {"type": "array", "items": {"type": "string"}},
    "source_projection_id": {"type": "string", "minLength": 1},
    "source_projection_file_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_projection_record_index": {"type": "integer", "minimum": 0},
    "source_operation_index": {"type": "integer", "minimum": 0},
    "source_operation_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}
