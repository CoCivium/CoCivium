{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/cojurisdiction-deed-v0.1.schema.json",
  "title":"CoJurisdictionWeave deed applicability v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","deed_id","observed_at","deed_class","principals","participants","nodes","candidate_regimes","route_disposition","authority_ceiling","responsibility_graph","evidence_refs","nonclaims"],
  "properties":{
    "schema":{"const":"CoJurisdictionWeave.DeedApplicability.v0.1-candidate"},
    "deed_id":{"type":"string","minLength":1},
    "observed_at":{"type":"string","format":"date-time"},
    "deed_class":{"type":"string","minLength":1},
    "principals":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "participants":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "nodes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "affected_parties":{"type":"array","items":{"type":"string","minLength":1}},
    "data_classes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "source_locations":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "processing_locations":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "destinations":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "target_markets":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "contracts":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "licenses":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "effect_locations":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "candidate_regimes":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["regime_id","source_ref","valid_time","applicability_state","confidence"],
        "properties":{
          "regime_id":{"type":"string","minLength":1},
          "source_ref":{"type":"string","minLength":1},
          "valid_time":{"type":"string","minLength":1},
          "applicability_state":{"enum":["APPLIES_PROVISIONALLY","MAY_APPLY","NOT_SHOWN_TO_APPLY","CONFLICTING_EVIDENCE","UNKNOWN"]},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "notes":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "route_disposition":{
      "type":"object","additionalProperties":false,
      "required":["state","reason","human_review_required"],
      "properties":{
        "state":{"enum":["ALLOW_BOUNDED","ALLOW_WITH_CONDITIONS","HOLD_REVIEW","HOLD_CONFLICT","HOLD_MISSING_CURRENTNESS","DENY_FOR_CURRENT_ROUTE"]},
        "reason":{"type":"string","minLength":1},
        "human_review_required":{"type":"boolean"},
        "conditions":{"type":"array","items":{"type":"string","minLength":1}},
        "prohibited_routes":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "authority_ceiling":{"enum":["OBSERVE_ONLY","CANDIDATE_ONLY","LOCAL_REVERSIBLE","BOUNDED_SHARED_WRITE","HUMAN_OR_PROFESSIONAL_GATE_REQUIRED"]},
    "responsibility_graph":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["subject","relation","object"],
        "properties":{
          "subject":{"type":"string","minLength":1},
          "relation":{"enum":["PROPOSED_BY","AUTHORIZED_BY","EXECUTED_BY","OPERATED_BY","REVIEWED_BY","DEPLOYED_BY","AFFECTS","BENEFITS","OWES_DUTY_TO","CAN_REVERSE","CAN_REMEDIATE","CAN_APPEAL_TO","GOVERNED_BY","SUBJECT_TO","CONFLICTS_WITH"]},
          "object":{"type":"string","minLength":1},
          "source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
        }
      }
    },
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "unresolved_conflicts":{"type":"array","items":{"type":"string","minLength":1}},
    "next_gate":{"type":"string"},
    "nonclaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}