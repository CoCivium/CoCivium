{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/CoCivium/CoCivium/schemas/coevo-receiver-bindings-v0.1.schema.json",
  "title":"CoEvo receiver bindings v0.1 candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["repository_receivers","session_receivers"],
  "properties":{
    "repository_receivers":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["receiver_repo","receiver_id","current_head"],
        "properties":{
          "receiver_repo":{"type":"string","minLength":1},
          "receiver_id":{"type":"string","minLength":1},
          "current_head":{"type":"string","minLength":1}
        }
      }
    },
    "session_receivers":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["profile_id","instance_id","currentness_cursor","confidentiality_capabilities"],
        "properties":{
          "profile_id":{"type":"string","minLength":1},
          "instance_id":{"type":"string","minLength":1},
          "currentness_cursor":{"type":"string","minLength":1},
          "confidentiality_capabilities":{
            "type":"array",
            "minItems":1,
            "items":{"enum":["PUBLIC","PRIVATE","RESTRICTED","UNKNOWN"]}
          }
        }
      }
    }
  }
}
