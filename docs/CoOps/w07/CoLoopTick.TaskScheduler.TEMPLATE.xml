<?xml version="1.0" encoding="UTF-8"?>
<!--
  W07 TEMPLATE ONLY. NOT REGISTERED. Do not import without separate install authority (design §3; next gate W07-C2-J5).
  Replace {{PYTHON_EXE}}, {{TICK_PY}}, {{STATE_DIR}}, {{USER_SID_OR_NAME}} before any use.
  Triggers: at startup, at logon, every 5 min, and on resume from sleep (System log, Power-Troubleshooter, Event ID 1).
  A tick is one-shot and idempotent, so extra triggers are harmless. IgnoreNew stops overlapping instances; the
  SQLite actuator lease stays the real guard (Task Scheduler alone is not trusted for exclusivity).
  Principal: S4U = runs whether or not the user is logged on, stores no password, has no network credentials
  (the tick is local-only by design). LeastPrivilege.
  Encoding: stored as UTF-8 for git; schtasks /create /xml expects UTF-16 LE, so convert first (Register-ScheduledTask -Xml takes the string).
  Read-only verify after a future, authorized import: schtasks /query /tn "\CoLoop\CoLoopTick" /xml
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>CoLoop+ one-shot tick (W07 candidate template). Local-only effects. See docs/CoOps/w07/.</Description>
    <URI>\CoLoop\CoLoopTick</URI>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger><Enabled>true</Enabled><Delay>PT1M</Delay></BootTrigger>
    <LogonTrigger><Enabled>true</Enabled><UserId>{{USER_SID_OR_NAME}}</UserId></LogonTrigger>
    <TimeTrigger>
      <Repetition><Interval>PT5M</Interval><StopAtDurationEnd>false</StopAtDurationEnd></Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary><Enabled>true</Enabled>
    </TimeTrigger>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="System"&gt;&lt;Select Path="System"&gt;*[System[Provider[@Name='Microsoft-Windows-Power-Troubleshooter'] and EventID=1]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
      <Delay>PT30S</Delay>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_SID_OR_NAME}}</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings><StopOnIdleEnd>false</StopOnIdleEnd><RestartOnIdle>false</RestartOnIdle></IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{PYTHON_EXE}}</Command>
      <Arguments>-I "{{TICK_PY}}" --state "{{STATE_DIR}}" tick</Arguments>
    </Exec>
  </Actions>
</Task>
