        "CORE_LESSON_COMPLETES_WITHOUT_VR",
        "PREDICTION_PRECEDES_TEST",
        "UNCERTAINTY_RECORDED"
      ]
    },
    {
      "id": "S02_VR_UNAVAILABLE",
      "condition": "All immersive devices fail before session.",
      "must_prove": [
        "NON_HEADSET_PATH_PRESERVES_OBJECTIVES",
        "NO_SESSION_CANCELLATION_REQUIRED"
      ]
    },
    {
      "id": "S03_NETWORK_UNAVAILABLE",
      "condition": "Internet unavailable after learners arrive.",
      "must_prove": [
        "LOCAL_OR_PRINTED_SOURCE_FALLBACK",
        "NO_REQUIRED_CLOUD_IDENTITY",
        "CORE_LESSON_CONTINUES"
      ]
    },
    {
      "id": "S04_MOTION_DISCOMFORT",
      "condition": "Learner reports dizziness during optional immersive view.",
      "must_prove": [
        "IMMEDIATE_IMMERSIVE_STOP",
        "NO_PENALTY",
        "NON_HEADSET_CONTINUATION",
        "SAFETY_OVERRIDES_COMPLETION"
      ]
    },
    {
      "id": "S05_ACCESSIBILITY_NO_HEADSET",
      "condition": "Learner cannot or chooses not to wear a headset.",
