      ]
    },
    {
      "id": "S09_SOURCE_UNAVAILABLE",
      "condition": "Official webpage is unavailable or changed.",
      "must_prove": [
        "CACHED_OR_PRINTED_DATED_SOURCE_OPTION",
        "SOURCE_CURRENTNESS_NOT_ASSUMED",
        "CLAIM_SCOPE_REDUCED_IF_SOURCE_UNVERIFIED"
      ]
    },
    {
      "id": "S10_TIME_COMPRESSION",
      "condition": "Class loses 20 minutes to an unrelated school event.",
      "must_prove": [
        "MINIMUM_45_MINUTE_PATH_EXISTS",
        "PREDICTION_AND_REVISION_NOT_DROPPED",
        "OPTIONAL_IMMERSIVE_LAYER_DROPPED_FIRST"
      ]
