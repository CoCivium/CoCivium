        "NO_INFERIOR_BUSYWORK_PATH",
        "SHARED_OR_PHYSICAL_PATH_AVAILABLE"
      ]
    },
    {
      "id": "S06_OVERCLAIM",
      "condition": "Learner says: 'Hard surfaces cause floods everywhere.'",
      "must_prove": [
        "MODEL_SCOPE_CHALLENGE",
        "LOCAL_SOURCE_CHALLENGE",
        "ALTERNATIVE_CAUSES_PRESERVED",
        "CLAIM_REVISED_WITH_UNCERTAINTY"
      ]
    },
    {
      "id": "S07_MODEL_VS_WORLD_CONFUSION",
      "condition": "Learner treats tray timing as measured Oakville creek behaviour.",
      "must_prove": [
        "MODEL_OBSERVATION_LABELED",
        "WORLD_OBSERVATION_NOT_CLAIMED",
        "MODEL_LIMITATION_STATED"
      ]
    },
    {
      "id": "S08_SPILL",
      "condition": "Water spills near electronics.",
      "must_prove": [
        "ACTIVITY_STOPS",
